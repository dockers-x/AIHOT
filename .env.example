# Copy to .env with ./init-env.sh. Never commit .env.
AIHOT_IMAGE=ghcr.io/dockers-x/aihot:latest
SITE_URL=http://localhost:3000
PORT=3000
TRUST_PROXY=false

# Required. init-env.sh generates secure random values for all four entries.
ADMIN_PASSWORD=
SESSION_SECRET=
IMG_PROXY_SIGN_SECRET=
POSTGRES_PASSWORD=

# Any OpenAI-compatible API. The site can start without a key, but model jobs stay disabled.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_EXTRA_JSON={"thinking":{"type":"disabled"}}

# Enable these after LLM_API_KEY and the model endpoint are configured.
COLLECT_ENABLED=false
MODEL_CALLS_ENABLED=false

# Optional settings.
INGEST_RATE_LIMIT=10
FEISHU_CONTENT_PUSH_ENABLED=false
FEISHU_INTERNAL_ENABLED=false
INDEXNOW_SUBMIT_ENABLED=false
